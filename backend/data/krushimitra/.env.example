# ── Required ─────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# ── Optional upgrades ────────────────────────────────────────
# Google Gemini — upgrades /chat to fully generative bilingual answers
GEMINI_API_KEY=

# NewsAPI.org key — reserved (Google News RSS works without a key)
NEWS_API_KEY=

# Google Maps Distance Matrix — exact road distances (haversine model used otherwise)
GOOGLE_MAPS_API_KEY=

# OpenWeatherMap — reserved (Open-Meteo live forecasts work without a key)
OPENWEATHER_API_KEY=
